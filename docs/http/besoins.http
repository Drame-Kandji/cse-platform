@gw = http://localhost:8080
# Jeton : scripts/token.sh <e-mail> (15 min)
@token = COLLER_LE_JETON_ICI

@besoinId = b0000000-0000-0000-0000-000000000037

### Lister les besoins (CHEF : filtrés sur ses chantiers)
GET {{gw}}/api/besoins?statut=EN_ATTENTE&priorite=URGENT&page=0&size=20&sort=createdAt,desc
Authorization: Bearer {{token}}

### Soumettre un besoin (CHEF sur ses chantiers, ou RM) — R08 : justification si URGENT/CRITIQUE
POST {{gw}}/api/besoins
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "chantierId": "c0000000-0000-0000-0000-000000000001",
  "designation": "Pelle hydraulique 20 t",
  "categorie": "MATERIEL_ROULANT",
  "quantite": 1,
  "specifications": "Godet 1 m³, chenilles",
  "priorite": "URGENT",
  "dureeUtilisationJours": 45,
  "dateBesoin": "2026-11-15",
  "justification": "Panne de la pelle affectée, terrassement à l'arrêt"
}

### Détail
GET {{gw}}/api/besoins/{{besoinId}}
Authorization: Bearer {{token}}

### Historique
GET {{gw}}/api/besoins/{{besoinId}}/historique
Authorization: Bearer {{token}}

### Modifier (demandeur, EN_ATTENTE uniquement — R05) : renseigner la version courante
PUT {{gw}}/api/besoins/{{besoinId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "chantierId": "c0000000-0000-0000-0000-000000000002",
  "designation": "Pelle hydraulique 20 t",
  "categorie": "MATERIEL_ROULANT",
  "quantite": 1,
  "priorite": "CRITIQUE",
  "dureeUtilisationJours": 45,
  "dateBesoin": "2026-11-10",
  "justification": "Chantier à l'arrêt",
  "version": 0
}

### Valider (RM uniquement — R01) : orientation automatique parc / achat
PATCH {{gw}}/api/besoins/{{besoinId}}/valider
Authorization: Bearer {{token}}
Content-Type: application/json

{ "commentaire": "Validé, priorité chantier", "materielIds": [] }

### Rejeter (RM, motif obligatoire — R08)
PATCH {{gw}}/api/besoins/{{besoinId}}/rejeter
Authorization: Bearer {{token}}
Content-Type: application/json

{ "motif": "Doublon avec BES-2026-0012" }

### Relancer l'orientation d'un besoin VALIDE en attente (RM)
POST {{gw}}/api/besoins/{{besoinId}}/orienter
Authorization: Bearer {{token}}

### Consolidation (RM)
GET {{gw}}/api/besoins/consolidation?statut=EN_ATTENTE
Authorization: Bearer {{token}}

### Statistiques
GET {{gw}}/api/besoins/statistiques
Authorization: Bearer {{token}}
