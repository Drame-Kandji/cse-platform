# Plateforme interne CSE - variables d'environnement (prefixe VITE_ obligatoire)
# URL de base de l'API (passerelle). En dev, Vite proxifie /api vers http://localhost:8080.
VITE_API_BASE_URL=/api
# Keycloak (Authorization Code + PKCE S256)
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=cse
VITE_KEYCLOAK_CLIENT_ID=cse-web-interne
# Mode d'authentification : keycloak | dev
# "dev" affiche un selecteur de role sans Keycloak (refuse hors `vite dev`).
VITE_AUTH_MODE=keycloak
