# Portail fournisseur CSE : variables d'environnement (prefixe VITE_ obligatoire)
# Memes variables que web-interne (validees par shared/config/env.ts), valeurs propres au portail.
# URL de base de l'API (passerelle). En dev, Vite proxifie /api vers http://localhost:8080.
VITE_API_BASE_URL=/api
# Keycloak (Authorization Code + PKCE S256)
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=cse
# Client public du portail (valeur par defaut appliquee par vite.config.ts si absente)
VITE_KEYCLOAK_CLIENT_ID=cse-portail-fournisseur
# Le portail utilise toujours Keycloak (pas de selecteur de role "dev").
VITE_AUTH_MODE=keycloak
