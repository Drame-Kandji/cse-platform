  "tags" : [ {
    "name" : "Reporting",
    "description" : "Tableaux de bord par profil, séries temporelles, exports"
  } ],
  "paths" : {
    "/api/reporting/series" : {
      "get" : {
        "tags" : [ "Reporting" ],
        "summary" : "Série temporelle d'un indicateur",
        "description" : "Un point par tranche (JOUR « 2026-07-14 », SEMAINE ISO « 2026-W29 », MOIS « 2026-07 »). Pour un cumul (MONTANT_ENGAGE, COUT_MAINTENANCE, BESOINS_SOUMIS) chaque tranche a un point, éventuellement 0 ; pour un taux ou une moyenne (TAUX_DISPONIBILITE, TAUX_UTILISATION, DELAI_APPROVISIONNEMENT) une tranche sans donnée n'a pas de point. L'indicateur doit relever d'une section d'un profil autorisé.",
        "operationId" : "serie",
        "parameters" : [ {
          "name" : "indicateur",
          "in" : "query",
          "description" : "Indicateur",
          "required" : true,
          "schema" : {
            "type" : "string",
            "enum" : [ "TAUX_DISPONIBILITE", "TAUX_UTILISATION", "MONTANT_ENGAGE", "COUT_MAINTENANCE", "BESOINS_SOUMIS", "DELAI_APPROVISIONNEMENT" ]
          },
          "example" : "TAUX_DISPONIBILITE"
        }, {
          "name" : "granularite",
          "in" : "query",
          "description" : "Granularité (défaut MOIS)",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "JOUR", "SEMAINE", "MOIS" ]
          },
          "example" : "MOIS"
        }, {
          "name" : "du",
          "in" : "query",
          "description" : "Premier jour (défaut : au − 89 jours)",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date"
          },
          "example" : "2026-08-01"
        }, {
          "name" : "au",
          "in" : "query",
          "description" : "Dernier jour (défaut : aujourd'hui)",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date"
          },
          "example" : "2026-10-30"
        }, {
          "name" : "chantierId",
          "in" : "query",
          "description" : "Restreint au chantier",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          },
          "example" : "c0000000-0000-0000-0000-000000000001"
        } ],
        "responses" : {
          "400" : {
            "description" : "Paramètre invalide (profil, indicateur, granularité, format, période)",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401" : {
            "description" : "Jeton absent ou invalide",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403" : {
            "description" : "Rôle sans tableau de bord, profil non autorisé (PROFIL_NON_AUTORISE), indicateur non autorisé ou chantier hors périmètre du chef (CHANTIER_NON_AUTORISE)",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "200" : {
            "description" : "Points de la série",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/Point"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/reporting/kpis" : {
      "get" : {
        "tags" : [ "Reporting" ],
        "summary" : "Tableau de bord d'un profil",
        "description" : "Indicateurs des sections du profil : DG → toutes ; RESPONSABLE_MATERIEL → parc, besoins, chantiers ; RESPONSABLE_ACHATS → achats, fournisseurs ; DAF → finances, achats, chantiers ; CHEF_CHANTIER → besoins, parc, chantiers limités à ses chantiers. Période par défaut : 90 derniers jours.",
        "operationId" : "kpis",
        "parameters" : [ {
          "name" : "profil",
          "in" : "query",
          "description" : "Profil : DG (tous les profils lui sont accessibles), DAF, RESPONSABLE_ACHATS, RESPONSABLE_MATERIEL, CHEF_CHANTIER. Défaut : profil principal du rôle.",
          "required" : false,
          "schema" : {
            "type" : "string"
          },
          "example" : "DG"
        }, {
          "name" : "du",
          "in" : "query",
          "description" : "Premier jour (défaut : au − 89 jours)",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date"
          },
          "example" : "2026-08-01"
        }, {
          "name" : "au",
          "in" : "query",
          "description" : "Dernier jour (défaut : aujourd'hui)",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date"
          },
          "example" : "2026-10-30"
        }, {
          "name" : "chantierId",
          "in" : "query",
          "description" : "Restreint au chantier (un chef ne peut choisir que l'un des siens)",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          },
          "example" : "c0000000-0000-0000-0000-000000000001"
        } ],
        "responses" : {
          "400" : {
            "description" : "Paramètre invalide (profil, indicateur, granularité, format, période)",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401" : {
            "description" : "Jeton absent ou invalide",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403" : {
            "description" : "Rôle sans tableau de bord, profil non autorisé (PROFIL_NON_AUTORISE), indicateur non autorisé ou chantier hors périmètre du chef (CHANTIER_NON_AUTORISE)",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "200" : {
            "description" : "Tableau de bord",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Tableau"
                }
              }
            }
          }
        }
      }
    },
    "/api/reporting/export" : {
      "get" : {
        "tags" : [ "Reporting" ],
        "summary" : "Exporter le tableau de bord",
