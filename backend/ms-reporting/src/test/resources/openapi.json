          },
          "example" : "pdf"
        }, {
          "name" : "profil",
          "in" : "query",
          "description" : "Profil : DG (tous les profils lui sont accessibles), DAF, RESPONSABLE_ACHATS, RESPONSABLE_MATERIEL, CHEF_CHANTIER. Défaut : profil principal du rôle.",
          "required" : false,
          "schema" : {
            "type" : "string"
          },
          "example" : "DG"
        }, {
          "name" : "du",
          "in" : "query",
          "description" : "Premier jour (défaut : au − 89 jours)",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date"
          },
          "example" : "2026-08-01"
        }, {
          "name" : "au",
          "in" : "query",
          "description" : "Dernier jour (défaut : aujourd'hui)",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date"
          },
          "example" : "2026-10-30"
        }, {
          "name" : "chantierId",
          "in" : "query",
          "description" : "Restreint au chantier",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          },
          "example" : "c0000000-0000-0000-0000-000000000001"
        } ],
        "responses" : {
          "400" : {
            "description" : "Paramètre invalide (profil, indicateur, granularité, format, période)",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401" : {
            "description" : "Jeton absent ou invalide",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403" : {
            "description" : "Rôle sans tableau de bord, profil non autorisé (PROFIL_NON_AUTORISE), indicateur non autorisé ou chantier hors périmètre du chef (CHANTIER_NON_AUTORISE)",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "200" : {
            "description" : "Fichier en pièce jointe",
            "headers" : {
              "Content-Disposition" : {
                "description" : "attachment; filename=\"tableau-de-bord-DG-2026-10-30.pdf\"",
                "style" : "simple",
                "schema" : {
                  "type" : "string"
                }
              }
            },
            "content" : {
              "application/pdf" : {
                "schema" : {
                  "type" : "string",
                  "format" : "binary"
                }
