  "info" : {
    "title" : "ms-reporting · Tableaux de bord",
    "description" : "Tableaux de bord par profil (DG, DAF, RA, RM, chef de chantier), séries temporelles et exports PDF / Excel, calculés sur des vues CQRS alimentées par les événements Kafka (aucun appel aux autres services).",
    "contact" : {
      "name" : "Équipe plateforme CSE",
      "email" : "support@cse.sn"
    },
    "version" : "2.0.0"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  }, {
    "keycloak" : [ ]
