  "components" : {
    "schemas" : {
      "ModifierUtilisateur" : {
        "type" : "object",
        "description" : "Modification d'un compte",
        "properties" : {
          "email" : {
            "type" : "string",
            "example" : "moussa.sy@cse.sn",
            "maxLength" : 255,
            "minLength" : 0
          },
          "prenom" : {
            "type" : "string",
            "example" : "Moussa",
            "maxLength" : 150,
            "minLength" : 0
          },
          "nom" : {
            "type" : "string",
            "example" : "Sy",
            "maxLength" : 150,
            "minLength" : 0
          },
          "telephone" : {
            "type" : "string",
            "example" : "+221 77 123 45 67",
            "maxLength" : 30,
            "minLength" : 0,
            "pattern" : "^[+0-9 ().-]*$"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "ADMIN_SYSTEME", "DIRECTION_GENERALE", "DAF", "RESPONSABLE_ACHATS", "RESPONSABLE_MATERIEL", "CHEF_CHANTIER", "FOURNISSEUR" ],
            "example" : "RESPONSABLE_MATERIEL"
          },
          "chantierIds" : {
            "type" : "array",
            "example" : [ "c0000000-0000-0000-0000-000000000001" ],
            "items" : {
              "type" : "string",
              "format" : "uuid"
            },
            "uniqueItems" : true
          },
          "perimetreParc" : {
            "type" : "string",
            "example" : "NATIONAL",
            "maxLength" : 100,
            "minLength" : 0
          },
          "seuilDelegation" : {
            "type" : "number",
            "example" : 150000000
          },
          "budgetGere" : {
            "type" : "number",
            "example" : 5000000000
          },
          "fournisseurId" : {
            "type" : "string",
            "format" : "uuid",
            "example" : "f0000000-0000-0000-0000-000000000001"
          }
        },
        "required" : [ "email", "nom", "prenom", "role" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string",
            "format" : "uri"
          },
          "title" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          }
        }
      },
      "Utilisateur" : {
        "type" : "object",
        "description" : "Profil d'un utilisateur de la plateforme",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Identifiant Keycloak (sub)",
            "example" : "00000000-0000-0000-0000-000000000101"
          },
          "email" : {
            "type" : "string",
            "description" : "Adresse e-mail (identifiant de connexion)",
            "example" : "chef.chantier@cse.sn"
          },
          "prenom" : {
            "type" : "string",
            "description" : "Prénom",
            "example" : "Mamadou"
          },
          "nom" : {
            "type" : "string",
            "description" : "Nom",
            "example" : "Diop"
          },
          "telephone" : {
            "type" : "string",
            "description" : "Téléphone",
            "example" : "+221 77 123 45 67"
          },
          "role" : {
            "type" : "string",
            "description" : "Rôle unique de l'utilisateur",
            "enum" : [ "ADMIN_SYSTEME", "DIRECTION_GENERALE", "DAF", "RESPONSABLE_ACHATS", "RESPONSABLE_MATERIEL", "CHEF_CHANTIER", "FOURNISSEUR" ],
            "example" : "CHEF_CHANTIER"
          },
          "actif" : {
            "type" : "boolean",
            "description" : "Compte actif (connexion autorisée)",
            "example" : true
          },
          "chantierIds" : {
            "type" : "array",
            "description" : "Chantiers attribués (chef de chantier uniquement)",
            "example" : [ "c0000000-0000-0000-0000-000000000001" ],
            "items" : {
              "type" : "string",
              "format" : "uuid"
            }
          },
          "perimetreParc" : {
            "type" : "string",
            "description" : "Périmètre du parc (responsable matériel)",
            "example" : "NATIONAL"
          },
          "seuilDelegation" : {
            "type" : "number",
            "description" : "Seuil de délégation en FCFA (responsable des achats)",
            "example" : 150000000
          },
          "budgetGere" : {
            "type" : "number",
            "description" : "Budget géré en FCFA (DAF)",
            "example" : 5000000000
          },
          "fournisseurId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "Fiche fournisseur rattachée (compte fournisseur)",
            "example" : "f0000000-0000-0000-0000-000000000001"
          },
          "otpConfigure" : {
            "type" : "boolean",
            "description" : "Second facteur TOTP configuré dans Keycloak",
            "example" : false
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Date de création du profil",
            "example" : "2026-10-30T09:15:00Z"
          }
        }
      },
      "CreerUtilisateur" : {
        "type" : "object",
        "description" : "Création d'un compte (Keycloak + profil)",
        "properties" : {
          "email" : {
            "type" : "string",
            "example" : "moussa.sy@cse.sn",
            "maxLength" : 255,
