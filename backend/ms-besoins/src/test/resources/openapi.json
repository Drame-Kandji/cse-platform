    "/api/besoins/consolidation" : {
      "get" : {
        "tags" : [ "Besoins" ],
        "summary" : "Consolider les besoins",
        "description" : "Regroupe les besoins EN_ATTENTE et/ou VALIDE par catégorie et désignation normalisée (casse, accents, ponctuation ignorés) et signale les doublons potentiels : même chantier, même désignation, dates de besoin proches (fenêtre configurable).",
        "operationId" : "consolidation",
        "parameters" : [ {
          "name" : "statut",
          "in" : "query",
          "description" : "EN_ATTENTE ou VALIDE (les deux si absent)",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "EN_ATTENTE", "VALIDE", "REJETE", "AFFECTE_DIRECT", "EN_ACHAT" ]
          },
          "example" : "EN_ATTENTE"
        } ],
        "responses" : {
          "200" : {
            "description" : "Regroupements",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/Consolidation"
                  }
                }
              }
            }
          },
          "400" : {
            "description" : "Statut non consolidable (STATUT_NON_CONSOLIDABLE)",
            "content" : {
              "application/problem+json" : {
