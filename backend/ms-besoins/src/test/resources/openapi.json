    "/api/besoins" : {
      "get" : {
        "tags" : [ "Besoins" ],
        "summary" : "Rechercher des besoins",
        "description" : "Liste paginée (taille max 50). Un chef de chantier ne voit que ses chantiers. Tri autorisé : createdAt, updatedAt, dateBesoin, priorite, statut, reference, quantite, designation (défaut : createdAt,desc). Les bornes du/au portent sur la date de soumission.",
        "operationId" : "rechercher",
        "parameters" : [ {
          "name" : "chantierId",
          "in" : "query",
          "description" : "Chantier",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          },
          "example" : "c0000000-0000-0000-0000-000000000001"
        }, {
          "name" : "statut",
          "in" : "query",
          "description" : "Statut",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "EN_ATTENTE", "VALIDE", "REJETE", "AFFECTE_DIRECT", "EN_ACHAT" ]
          },
          "example" : "EN_ATTENTE"
        }, {
          "name" : "priorite",
          "in" : "query",
          "description" : "Priorité",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "NORMAL", "URGENT", "CRITIQUE" ]
          },
          "example" : "URGENT"
        }, {
          "name" : "categorie",
          "in" : "query",
          "description" : "Catégorie",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "MATERIEL_ROULANT", "OUTILLAGE", "EQUIPEMENT_INFORMATIQUE", "CONSOMMABLE" ]
          },
          "example" : "MATERIEL_ROULANT"
        }, {
          "name" : "q",
          "in" : "query",
          "description" : "Texte recherché (référence, désignation, spécifications)",
          "required" : false,
          "schema" : {
            "type" : "string"
          },
          "example" : "pelle"
        }, {
          "name" : "du",
          "in" : "query",
          "description" : "Soumis à partir du (inclus)",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date"
          },
          "example" : "2026-01-01"
        }, {
          "name" : "au",
          "in" : "query",
          "description" : "Soumis jusqu'au (inclus)",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date"
          },
          "example" : "2026-12-31"
        }, {
          "name" : "page",
          "in" : "query",
          "description" : "Page (base 0)",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          },
          "example" : 0
        }, {
          "name" : "size",
          "in" : "query",
          "description" : "Taille (max 50)",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          },
          "example" : 20
        }, {
          "name" : "sort",
          "in" : "query",
          "description" : "Tri champ,asc|desc",
          "required" : false,
          "schema" : {
            "type" : "string"
          },
          "example" : "createdAt,desc"
        } ],
        "responses" : {
          "200" : {
            "description" : "Page de besoins",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseBesoin"
                }
              }
            }
          },
          "400" : {
            "description" : "Paramètre invalide ou tri non autorisé (TRI_NON_AUTORISE)",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401" : {
            "description" : "Non authentifié",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403" : {
            "description" : "Rôle insuffisant ou chantier non attribué",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "Besoins" ],
        "summary" : "Soumettre un besoin",
        "description" : "Crée un besoin EN_ATTENTE. Un chef de chantier ne peut le rattacher qu'à un de ses chantiers ; le chantier doit exister et être EN_COURS (vérifié auprès de ms-suivi). Règle R08 : justification obligatoire si la priorité est URGENT ou CRITIQUE. Publie BESOIN_SOUMIS.",
        "operationId" : "soumettre",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SoumissionBesoin"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Besoin créé",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Besoin"
                }
              }
            }
          },
          "400" : {
            "description" : "Champs invalides",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401" : {
            "description" : "Non authentifié",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403" : {
            "description" : "Rôle insuffisant ou chantier non attribué (CHANTIER_NON_ATTRIBUE)",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "422" : {
            "description" : "JUSTIFICATION_OBLIGATOIRE (R08), CHANTIER_INTROUVABLE, CHANTIER_INACTIF, DATE_BESOIN_PASSEE",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "503" : {
            "description" : "ms-suivi indisponible (SERVICE_SUIVI_INDISPONIBLE)",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
