{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "ms-besoins — Besoins en matériel",
    "description" : "Expression des besoins en matériel par les chantiers, validation par le Responsable Matériel (R01), orientation automatique vers l'affectation directe (ms-suivi) ou les achats, consolidation et statistiques.",
    "contact" : {
      "name" : "Équipe plateforme CSE",
      "email" : "support@cse.sn"
    },
    "version" : "2.0.0"
  },
  "security" : [ {
    "bearerAuth" : [ ]
  }, {
    "keycloak" : [ ]
  } ],
  "tags" : [ {
    "name" : "Besoins",
    "description" : "Expression, validation (R01), rejet motivé (R08) et orientation des besoins en matériel des chantiers : affectation directe depuis le parc ou transmission aux achats."
  } ],
  "paths" : {
    "/api/besoins/{id}" : {
      "get" : {
        "tags" : [ "Besoins" ],
        "summary" : "Consulter un besoin",
        "description" : "Un chef de chantier ne consulte que les besoins de ses chantiers.",
        "operationId" : "obtenir",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "description" : "Identifiant du besoin",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Besoin",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Besoin"
                }
              }
            }
          },
          "401" : {
            "description" : "Non authentifié",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403" : {
            "description" : "Rôle insuffisant ou chantier non attribué (ACCES_CHANTIER_REFUSE)",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404" : {
            "description" : "Besoin introuvable (BESOIN_INTROUVABLE)",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      },
      "put" : {
        "tags" : [ "Besoins" ],
        "summary" : "Modifier un besoin",
        "description" : "Réservé au demandeur, uniquement tant que le besoin est EN_ATTENTE (règle R05). Publie BESOIN_MODIFIE.",
        "operationId" : "modifier",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "description" : "Identifiant du besoin",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ModificationBesoin"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Besoin modifié",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Besoin"
                }
              }
            }
          },
          "400" : {
            "description" : "Champs invalides",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401" : {
            "description" : "Non authentifié",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403" : {
            "description" : "Pas le demandeur (MODIFICATION_RESERVEE_DEMANDEUR) ou chantier non attribué",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404" : {
            "description" : "Besoin introuvable",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
