    "/api/besoins/{id}/valider" : {
      "patch" : {
        "tags" : [ "Besoins" ],
        "summary" : "Valider un besoin (Responsable Matériel, R01)",
        "description" : "Valide un besoin EN_ATTENTE puis l'oriente : interrogation de la disponibilité du parc (ms-suivi) ; si elle suffit, affectation des matériels (ceux de materielIds en priorité) du dateBesoin au dateBesoin + dureeUtilisationJours → AFFECTE_DIRECT ; sinon → EN_ACHAT. Si ms-suivi est indisponible, le besoin reste VALIDE avec orientationEnAttente=true. Publie BESOIN_VALIDE puis BESOIN_AFFECTE_DIRECT ou BESOIN_EN_ACHAT.",
        "operationId" : "valider",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "description" : "Identifiant du besoin",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ValidationBesoin"
              }
            }
          }
        },
        "responses" : {
          "200" : {
            "description" : "Besoin validé (et orienté si possible)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Besoin"
                }
              }
            }
          },
          "400" : {
            "description" : "Champs invalides",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401" : {
            "description" : "Non authentifié",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403" : {
            "description" : "Réservé au Responsable Matériel (R01, VALIDATION_NON_AUTORISEE)",
            "content" : {
