# Copier vers .env (non versionné) et remplacer les valeurs. Toutes sont des valeurs de DÉVELOPPEMENT.

# --- PostgreSQL (superutilisateur + un utilisateur par microservice) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeit-postgres
# Mot de passe par défaut des utilisateurs ms_<service> ; surcharger avec DB_PASSWORD_<SERVICE> en production.
CSE_DB_PASSWORD=changeit-services
KEYCLOAK_DB_PASSWORD=changeit-keycloak

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeit-admin
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-cse-admin-api-secret-a-changer

# --- Chiffrement AES-256-GCM des données sensibles (32 octets en Base64) ---
# Générer : head -c32 /dev/urandom | base64
CSE_CRYPTO_KEY=

# --- Assistant IA (ms-chatbot) : API compatible OpenAI (OpenAI, Mistral, Ollama /v1…) ---
# Sans clé, l'assistant fonctionne en mode dégradé (réponses construites à partir des données, sans LLM).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Frontend (web-interne) ---
VITE_API_BASE_URL=/api
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=cse
VITE_KEYCLOAK_CLIENT_ID=cse-web-interne

# --- Frontal HTTPS conteneurisé (service web-interne, profil apps) ---
# Ports publiés sur l'hôte (conteneur : 8443 HTTPS, 8080 HTTP → 301). Certificats : make certs.
WEB_HTTPS_PORT=8443
WEB_HTTP_PORT=8000
CSE_IMAGE_TAG=dev

# --- Sauvegardes PostgreSQL (service backup, profils apps / backup) ---
BACKUP_BASES=cse keycloak
BACKUP_RETENTION_JOURS=90
# Heure UTC de la sauvegarde quotidienne (HH:MM)
BACKUP_HEURE=02:00

# --- Passerelle : limitation de débit par utilisateur (jetons/s et rafale) ---
# Ne jamais désactiver en production ; ajuster uniquement sur un environnement de performance.
GATEWAY_RATE_LIMIT_REPLENISH=20
GATEWAY_RATE_LIMIT_BURST=40
